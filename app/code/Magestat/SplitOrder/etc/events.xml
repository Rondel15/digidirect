<?xml version="1.0" encoding="UTF-8"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="add_seller_to_order" instance="Marketplacer\SellerApi\Observer\Sales\ConvertQuoteToOrder" disabled="true"/>
    </event>
    <event name="sales_order_invoice_register">
        <observer name="add_seller_to_invoice" instance="Marketplacer\SellerApi\Observer\Sales\InvoiceRegister" disabled="true"/>
    </event>
    <event name="sales_order_shipment_save_before">
        <observer name="add_seller_to_shipment" instance="Marketplacer\SellerApi\Observer\Sales\ShipmentSaveBefore" disabled="true"/>
    </event>
</config>