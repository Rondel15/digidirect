<script>
    const pageWrapper = document.querySelector('.page-wrapper');

    if (pageWrapper) {
        const partyCanvas = document.createElement('canvas');
        partyCanvas.id = 'party-canvas'; // Set the ID so you can target it
        partyCanvas.style.position = 'absolute';
        partyCanvas.style.top = '0';
        partyCanvas.style.left = '0';
        partyCanvas.style.width = '100%';
        partyCanvas.style.height = '100%';
        partyCanvas.style.pointerEvents = 'none';
        partyCanvas.style.zIndex = '9999';

        pageWrapper.parentNode.insertBefore(partyCanvas, pageWrapper.nextSibling);
    }


    let animationFrameId;
    const canvas = document.getElementById("party-canvas");
    const ctx = canvas.getContext("2d");
    const particles = [];

    const gradientPairs = [
        ["#00A1FF", "#422FD4"],
        ["#FF003C", "#FF455E"],
        ["#C20094", "#9C00C2"],
        ["#D1D100", "#93D100"],
        ["#FFA600", "#FFD100"]
    ];

    function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }

    resizeCanvas();
    window.addEventListener("resize", resizeCanvas);

    function createParticle() {
        const gradient = gradientPairs[Math.floor(Math.random() * gradientPairs.length)];
        const width = Math.random() * 30 + 5;
        const height = Math.random() * 45 + 20;

        particles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height - canvas.height,
            width: width,
            height: height,
            speedX: (Math.random() - 0.5) * 4,
            speedY: Math.random() * 4 + 5,
            rotation: (Math.random() - 0.5) * 3,
            gradient: gradient,
            stopped: false
        });
    }

    function updateParticle(particle) {
        if (particle.stopped) return;

        particle.x += particle.speedX;
        particle.y += particle.speedY;
        particle.x += Math.sin(particle.y * 0.1) * Math.random() * 0.5;

        if (particle.y >= canvas.height - particle.height) {
            particle.y = canvas.height - particle.height;
            particle.speedX = 0;
            particle.speedY = 0;
            particle.rotation = 0;
            particle.stopped = true;

            setTimeout(() => {
                const idx = particles.indexOf(particle);
                if (idx > -1) {
                    particles.splice(idx, 1);
                }
            }, 0);
        }

    }

    function drawParticle(particle) {
        ctx.save();
        ctx.translate(particle.x, particle.y);
        ctx.rotate(particle.rotation);

        // Gradient direction from top-left to bottom-right of the confetti piece
        const gradient = ctx.createLinearGradient(0, 0, particle.width, particle.height);
        gradient.addColorStop(0, particle.gradient[0]);
        gradient.addColorStop(1, particle.gradient[1]);

        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, particle.width, particle.height);

        ctx.restore();
    }

    for (let i = 0; i < 200; i++) {
        createParticle();
    }

    function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach((particle) => {
            updateParticle(particle);
            drawParticle(particle);
        });

        const allStopped = particles.every(p => p.stopped);
        if (!allStopped) {
            animationFrameId = requestAnimationFrame(animate);
        } else {
            console.log("All confetti landed 🎉");
            cancelAnimationFrame(animationFrameId);
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            canvas.style.display = 'none';
        }
    }

    animate();

</script>

