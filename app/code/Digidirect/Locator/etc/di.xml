<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Digidirect\Locator\Model\Config\Data">
        <arguments>
            <argument name="reader" xsi:type="object">Digidirect\Locator\Model\Config\Reader</argument>
            <argument name="cacheId" xsi:type="string">locator</argument>
        </arguments>
    </type>

    <type name="Digidirect\Locator\Model\Config\Reader">
        <arguments>
            <argument name="converter" xsi:type="object">Digidirect\Locator\Model\Config\Converter</argument>
            <argument name="schemaLocator" xsi:type="object">Digidirect\Locator\Model\Config\SchemaLocator</argument>
            <argument name="fileName" xsi:type="string">locator.xml</argument>
        </arguments>
    </type>
</config>

