<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <route url="/V1/check_ssd_availability/:id" method="GET">
        <service class="Digidirect\Digi\Api\Rest\CheckSsdAvailabilityInterface" method="getById"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/check_vsm_availability/:country/code/:postCode" method="GET">
        <service class="Digidirect\Digi\Api\Rest\CheckVsmAvailabilityInterface" method="getByCountryAndPostCode"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
