<?xml version="1.0"?>
<logging xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Logging:etc/logging.xsd">
    <groups>
        <group name="digidirect_country_address_attributes">
            <label translate="true">Manage Country Address Attributes</label>
            <expected_models>
                <expected_model class="Digidirect\AddressVerification\Model\CountryAddressAttribute" />
            </expected_models>
            <events>
                <event controller_action="digidirect_addressverification_countryaddress_edit" action_alias="view" />
                <event controller_action="digidirect_addressverification_countryaddress_save" action_alias="save">
                    <skip_on_back>
                        <controller_action name="digidirect_addressverification_edit" />
                    </skip_on_back>
                </event>
            </events>
        </group>
    </groups>
</logging>