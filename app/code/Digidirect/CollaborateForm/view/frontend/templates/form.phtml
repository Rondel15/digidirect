<script>
    
//    digi-seconds modal form
    require(
        [
            'jquery',
            'Magento_Ui/js/modal/modal'
        ],
        function(
            $,
            modal
        ) {
            var options = {
                type: 'popup',
                responsive: true,
                innerScroll: true,
                title: '',
                buttons: [{
                    text: $.mage.__('Close'),
                    class: '',
                    click: function () {
                        this.closeModal();
                    }
                }],
                opened: function($Event) {
                    
                    // $(".modal-footer").hide();
                    $(".modal-header").css("background-color","transparent");
                    $(".modal-footer").hide();
                    // $(".modal-header button.action-close:before").css("color","#cacaca");
                    // $(".modal-inner-wrap").css("width","50% !important");

                    var handleMatchMedia = function(md) {
                        if (md.matches) {
                            // alert("matched");
                            $('.modal-popup._show .modal-inner-wrap').attr('style', 'width: 80% !important; top: 50px;');
                            
                        } else {
                            // alert("not matched");
                            $('.modal-popup._show .modal-inner-wrap').attr('style', 'width: 50% !important;');
                        }
                    }

                    var mq = window.matchMedia("(max-width: 768px)");

                    // call function
                    handleMatchMedia(mq);

                    //call addListener function  
                    mq.addListener(handleMatchMedia);

                }
            };  

            var popup = modal(options, $('#collaborateForm'));
            $("#digisecondsForm_trigger1,#digisecondsForm_trigger2").on('click',function(){ 
                $("#collaborateForm").modal("openModal");
            });
            // $( "#digisecondsForm_trigger" ).prepend( "<b>Hello </b>" );
            
            window.setTimeout(function () {
                $("#collaborateForm").attr('style', 'display: block;');
            }, 3000);

        }
    );
</script>

<script>
