<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config" title="Configuration" sortOrder="20">
                            <resource id="Digidirect_ExtendedShippingRates::config_extendedshippingrates" title="Shipping Rules Section (by Digidirect)" sortOrder="90" />
                        </resource>
                    </resource>
                </resource>
                <resource id="Digidirect_Utilities::Digidirect" sortOrder="100">
                    <resource id="Digidirect_ExtendedShippingRates::extendedshippingrates" sortOrder="40" title="Digidirect Shipping Suite">
                        <resource id="Digidirect_ExtendedShippingRates::quote" sortOrder="40" title="Shipping Rules &amp; Restrictions (by Digidirect)" />
                        <resource id="Digidirect_ExtendedShippingRates::zone" sortOrder="50" title="Shipping Zones (by Digidirect)" />
                        <resource id="Digidirect_ExtendedShippingRates::carrier" sortOrder="45" title="Manage Carriers &amp; Shipping Methods (by Digidirect)" />
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
