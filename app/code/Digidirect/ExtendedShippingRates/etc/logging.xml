<?xml version="1.0"?>
<logging xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Logging:etc/logging.xsd">
    <groups>
        <group name="digidirect_extendedshippingrates_carrier">
            <label translate="true">Manage Extended Shipping Rates Carriers</label>
            <expected_models>
                <expected_model class="Digidirect\ExtendedShippingRates\Model\Carrier" />
            </expected_models>
            <events>
                <event controller_action="digidirect_extendedshippingrates_extendedshippingrates_carrier_edit"
                       action_alias="view" />
                <event controller_action="digidirect_extendedshippingrates_extendedshippingrates_carrier_save"
                       action_alias="save">
                    <skip_on_back>
                        <controller_action name="digidirect_extendedshippingrates_extendedshippingrates_carrier_edit" />
                    </skip_on_back>
                </event>
                <event controller_action="digidirect_extendedshippingrates_extendedshippingrates_carrier_delete"
                       action_alias="delete" />
                <event controller_action="digidirect_extendedshippingrates_extendedshippingrates_carrier_massChangeStatus"
                       action_alias="massUpdate" />
                <event controller_action="digidirect_extendedshippingrates_extendedshippingrates_carrier_massDelete"
                       action_alias="massDelete" />
            </events>
        </group>
