<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digidirect_extendedshippingrates_zone_form.digidirect_extendedshippingrates_zone_form_data_source</item>
            <item name="deps" xsi:type="string">digidirect_extendedshippingrates_zone_form.digidirect_extendedshippingrates_zone_form_data_source</item>
            <item name="namespace" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
            <item name="component" xsi:type="string">Magento_Ui/js/form/form</item>
        </item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">Digidirect\ExtendedShippingRates\Block\Adminhtml\ExtendedShippingRates\Zone\Edit\Button\Back</item>
            <item name="save" xsi:type="string">Digidirect\ExtendedShippingRates\Block\Adminhtml\ExtendedShippingRates\Zone\Edit\Button\Save</item>
            <item name="delete" xsi:type="string">Digidirect\ExtendedShippingRates\Block\Adminhtml\ExtendedShippingRates\Zone\Edit\Button\Delete</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
        </item>
        <item name="childrenFromMeta" xsi:type="boolean">true</item>
    </argument>
    <dataSource name="digidirect_extendedshippingrates_zone_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Digidirect\ExtendedShippingRates\Ui\DataProvider\Zone\Form\ZoneDataProvider</argument>
            <argument name="name" xsi:type="string">digidirect_extendedshippingrates_zone_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="general">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Zone Information</item>
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="sortOrder" xsi:type="number">10</item>
                <item name="opened" xsi:type="boolean">true</item>
            </item>
        </argument>
        <field name="entity_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">hidden</item>
                    <item name="dataScope" xsi:type="string">entity_id</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
                </item>
            </argument>
        </field>
        <field name="name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Zone Name</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">name</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="zone_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Zone Id</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">zone_id</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
                </item>
            </argument>
        </field>
        <field name="attribute_set" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
                </item>
            </argument>
            <settings>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>0</value>
                            <actions>
                                <action name="0">
                                    <target>digidirect_extendedshippingrates_zone_form.digidirect_extendedshippingrates_zone_form.general.country_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="1">
                                    <target>digidirect_extendedshippingrates_zone_form.digidirect_extendedshippingrates_zone_form.general.region_id</target>
                                    <callback>hide</callback>
                                </action>
                                <action name="2">
                                    <target>digidirect_extendedshippingrates_zone_form.digidirect_extendedshippingrates_zone_form.general.postcode</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>1</value>
                            <actions>
                                <action name="0">
                                    <target>digidirect_extendedshippingrates_zone_form.digidirect_extendedshippingrates_zone_form.general.country_id</target>
                                    <callback>show</callback>
                                </action>
                                <action name="1">
                                    <target>digidirect_extendedshippingrates_zone_form.digidirect_extendedshippingrates_zone_form.general.region_id</target>
                                    <callback>show</callback>
                                </action>
                                <action name="2">
                                    <target>digidirect_extendedshippingrates_zone_form.digidirect_extendedshippingrates_zone_form.general.postcode</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
                <dataType>number</dataType>
                <label translate="true">Attribute Set</label>
                <dataScope>attribute_set</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Digidirect\ExtendedShippingRates\Model\Config\Source\Zone\AttributeSet"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="description">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Description</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">textarea</item>
                    <item name="dataScope" xsi:type="string">description</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
                </item>
            </argument>
        </field>
        <field name="is_active">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">boolean</item>
                    <item name="formElement" xsi:type="string">checkbox</item>
                    <item name="prefer" xsi:type="string">toggle</item>
                    <item name="valueMap" xsi:type="array">
                        <item name="true" xsi:type="number">1</item>
                        <item name="false" xsi:type="number">0</item>
                    </item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                    <item name="default" xsi:type="number">1</item>
                    <item name="label" xsi:type="string" translate="true">Active</item>
                    <item name="dataScope" xsi:type="string">is_active</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
                </item>
            </argument>
        </field>
        <field name="priority">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Priority</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">priority</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
                </item>
            </argument>
        </field>
        <field name="store_ids">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Cms\Ui\Component\Listing\Column\Cms\Options</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">int</item>
                    <item name="label" xsi:type="string" translate="true">Store View</item>
                    <item name="formElement" xsi:type="string">multiselect</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
                    <item name="dataScope" xsi:type="string">store_id</item>
                    <item name="default" xsi:type="string">0</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="country_id">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Digidirect\ExtendedShippingRates\Model\Config\Source\Locale\Country</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Country</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">country_id</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
                </item>
            </argument>
        </field>
        <field name="region_id">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Digidirect\ExtendedShippingRates\Model\Config\Source\RegionCollection</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">State</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">region_id</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
                    <!--<item name="customEntry" xsi:type="string">region</item>-->
                    <item name="filterBy" xsi:type="array">
                        <item name="target" xsi:type="string">${ $.provider }:${ $.parentScope }.country_id</item>
                        <item name="field" xsi:type="string">country_id</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="postcode">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Postcode</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">textarea</item>
                    <item name="dataScope" xsi:type="string">postcode</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_zone_form</item>
                    <item name="notice" xsi:type="string" translate="true">Comma-separated. Range could be defined using dash.</item>
                </item>
            </argument>
        </field>
    </fieldset>
    <fieldset name="conditions">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Conditions</item>
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="sortOrder" xsi:type="number">20</item>
                <item name="opened" xsi:type="boolean">true</item>
            </item>
        </argument>
        <container name="store_view_labels" >
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">40</item>
                </item>
            </argument>
            <htmlContent name="html_content">
                <argument name="block" xsi:type="object">Digidirect\ExtendedShippingRates\Block\Adminhtml\ExtendedShippingRates\Zone\Edit\Tab\Conditions</argument>
            </htmlContent>
        </container>
    </fieldset>
</form>
