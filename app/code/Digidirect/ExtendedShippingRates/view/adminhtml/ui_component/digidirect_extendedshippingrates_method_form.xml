<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digidirect_extendedshippingrates_method_form.digidirect_extendedshippingrates_method_form_data_source</item>
            <item name="deps" xsi:type="string">digidirect_extendedshippingrates_method_form.digidirect_extendedshippingrates_method_form_data_source</item>
            <item name="namespace" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
            <item name="component" xsi:type="string">Digidirect_ExtendedShippingRates/js/method_form</item>
        </item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">Digidirect\ExtendedShippingRates\Block\Adminhtml\ExtendedShippingRates\Method\Edit\Button\Back</item>
            <item name="save" xsi:type="string">Digidirect\ExtendedShippingRates\Block\Adminhtml\ExtendedShippingRates\Method\Edit\Button\Save</item>
            <item name="delete" xsi:type="string">Digidirect\ExtendedShippingRates\Block\Adminhtml\ExtendedShippingRates\Method\Edit\Button\Delete</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
        </item>
        <item name="childrenFromMeta" xsi:type="boolean">true</item>
    </argument>
    <dataSource name="digidirect_extendedshippingrates_method_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Digidirect\ExtendedShippingRates\Ui\DataProvider\Method\Form\MethodDataProvider</argument>
            <argument name="name" xsi:type="string">digidirect_extendedshippingrates_method_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="general">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Method Information</item>
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="sortOrder" xsi:type="number">10</item>
                <item name="opened" xsi:type="boolean">true</item>
            </item>
        </argument>
        <field name="entity_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">hidden</item>
                    <item name="dataScope" xsi:type="string">entity_id</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
                </item>
            </argument>
        </field>
        <field name="title">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Title</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">title</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="alternative_title">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Alternative Title</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">alternative_title</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
                </item>
            </argument>
        </field>
        <field name="code">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Code</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">code</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
                    <item name="validation" xsi:type="array">
                        <item name="validate-alphanum" xsi:type="boolean">true</item>
                        <item name="max_text_length" xsi:type="number">18</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="active">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">boolean</item>
                    <item name="formElement" xsi:type="string">checkbox</item>
                    <item name="prefer" xsi:type="string">toggle</item>
                    <item name="valueMap" xsi:type="array">
                        <item name="true" xsi:type="number">1</item>
                        <item name="false" xsi:type="number">0</item>
                    </item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                    <item name="default" xsi:type="number">1</item>
                    <item name="label" xsi:type="string" translate="true">Active</item>
                    <item name="dataScope" xsi:type="string">active</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
                </item>
            </argument>
        </field>
        <field name="price">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Price</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">price</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="cost">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Cost</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">cost</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
                </item>
            </argument>
        </field>
        <field name="packaging_weight_type">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Digidirect\ExtendedShippingRates\Model\Config\Source\WeightType</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Packaging Weight, type</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">packaging_weight_type</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
                </item>
            </argument>
            <settings>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>fixed</value>
                            <actions>
                                <action name="0">
                                    <target>digidirect_extendedshippingrates_method_form.digidirect_extendedshippingrates_method_form.general.packaging_weight_value</target>
                                    <callback>show</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>percentage</value>
                            <actions>
                                <action name="0">
                                    <target>digidirect_extendedshippingrates_method_form.digidirect_extendedshippingrates_method_form.general.packaging_weight_value</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                        <rule name="2">
                            <value>empty</value>
                            <actions>
                                <action name="0">
                                    <target>digidirect_extendedshippingrates_method_form.digidirect_extendedshippingrates_method_form.general.packaging_weight_value</target>
                                    <callback>hide</callback>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
            </settings>
        </field>
        <field name="packaging_weight_value">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Packaging Weight, value</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">packaging_weight_value</item>
                    <item name="source" xsi:type="string">digidirect_extendedshippingrates_method_form</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                    <item name="visible" xsi:type="boolean">false</item>
                </item>
            </argument>
        </field>
        <field name="import_rates">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string">Import Rates</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="formElement" xsi:type="string">fileUploader</item>
                    <item name="allowedExtensions" xsi:type="string">csv</item>
                    <item name="previewTmpl" xsi:type="string">Digidirect_ExtendedShippingRates/form/element/uploader/preview.html</item>
                    <item name="uploaderConfig" xsi:type="array">
                        <item name="url" xsi:type="url" path="digidirect_extendedshippingrates/extendedshippingrates_rate/upload"/>
                    </item>
                </item>
            </argument>
        </field>
    </fieldset>
    <fieldset name="rate">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Rates</item>
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="sortOrder" xsi:type="number">20</item>
                <item name="opened" xsi:type="boolean">false</item>
            </item>
        </argument>
    </fieldset>
    <fieldset name="labels">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Labels</item>
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="sortOrder" xsi:type="string">40</item>
                <item name="imports" xsi:type="array">
                    <item name="visible" xsi:type="string">!${ $.provider }:data.single_store</item>
                </item>
            </item>
        </argument>
        <container name="store_view_labels" >
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">40</item>
                </item>
            </argument>
            <htmlContent name="html_content">
                <argument name="block" xsi:type="object">Digidirect\ExtendedShippingRates\Block\Adminhtml\ExtendedShippingRates\Method\Edit\Tab\Labels</argument>
            </htmlContent>
        </container>
    </fieldset>
</form>
