    function slots(widgetId, productId, recommenderId, campaignId, tacticId, retailBoostCollectionCampaignId, adSetId, adSetVersion, costPerClick, timeStamp, hmacSalt, hmac, keywordId) {

        //var widgetId = '631dfdd4-dc01-ef11-abf3-02bf4bf6447c';

        var date = new Date();
        
        var events = {
                currentUrl: currentUrl,
                eventTime: date.toISOString(),
                refId: productId,
                widgetId: widgetId,
                routeId: routeId,              
                recommenderId: recommenderId,
                campaignId: campaignId,
                tacticId: tacticId,
                retailBoostCollectionCampaignId: retailBoostCollectionCampaignId,
                adSetId: adSetId,
                adSetVersion: adSetVersion,
                costPerClick: costPerClick,
                timeStamp: timeStamp,
                hmacSalt: hmacSalt,
                hmac: hmac,
                keywordId: keywordId
            }
            
        if (!retailBoostCollectionCampaignId || retailBoostCollectionCampaignId == "undefined") {
