<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Digidirect\AbstractAttributes\Block\Attribute\View" name="aa.attribute.view">
                <arguments>
                    <argument name="pager_limit" xsi:type="helper" helper="Digidirect\AbstractAttributes\Helper\Data::getLimitPerPage"/>
                </arguments>
                <block class="Magento\Theme\Block\Html\Pager" name="aa.attribute.view.pager"/>
                <container name="aa.attribute.view.pager.after"/>
            </block>
        </referenceContainer>
    </body>
</page>
