            <argument name="converter" xsi:type="object">Digidirect\AbstractGiftCard\Service\Http\Converter\XmlStringToArray</argument>
        </arguments>
    </virtualType>

    <virtualType name="ViiValueHandlerPool" type="Digidirect\AbstractGiftCard\Service\Config\ValueHandlerPool">
