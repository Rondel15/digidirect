<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="giftcard_service">
            <group id="vii" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Vii</label>
                <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>GiftCard Option</label>
                </field>
                <field id="endpoint_url" translate="label" type="text" sortOrder="4" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Endpoint Url</label>
                </field>
                <field id="user_name" translate="label" type="text" sortOrder="4" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>User Name</label>
                </field>
                <field id="password" translate="label" type="obscure" sortOrder="4" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>User Password</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="account_id" translate="label" type="text" sortOrder="4" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Vii Store Id</label>
                </field>
                <field id="curl_ssl_version" translate="label" type="select" sortOrder="5" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Curl SSL Version</label>
                    <source_model>Digidirect\AbstractGiftCard\Model\Config\Source\SslVersion</source_model>
                </field>
                <field id="mapping_not_responding_message" translate="label" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Not Responding Message Mapping</label>
                    <frontend_model>Digidirect\Vii\Block\Adminhtml\Config\NotRespondingMessageMatrix</frontend_model>
                    <backend_model>Digidirect\Utilities\Model\System\Config\Backend\DefaultOptionModel</backend_model>
                    <comment>If VII is not responding for specific RequestType, the warning message will be displayed on the front-end.</comment>
                </field>
                <field id="mapping_card_status" translate="label" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Card Status Mapping</label>
                    <frontend_model>Digidirect\Vii\Block\Adminhtml\Config\CardStatusMatrix</frontend_model>
                    <backend_model>Digidirect\Utilities\Model\System\Config\Backend\DefaultOptionModel</backend_model>
                </field>
                <field id="cancellation_delay" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>PreAuthCancellation Delay After PreAuthRequest</label>
                    <comment>
                        <![CDATA[
                            Number of days should pass before PreAuthCancellation will be sent after PreAuthRequest.<br/>
                            Please be aware that specified period should be less than Cart lifetime which is set up in <br/>
                            Stores->Configurations->Sales->Checkout->Shopping Cart->Quote Lifetime (days).
                        ]]>
                    </comment>
                </field>
                <field id="order_cron_expr" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Order PreAuthCancellation run schedule</label>
                </field>
                <field id="quote_cron_expr" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Quote PreAuthCancellation run schedule</label>
                </field>
                <field id="quote_visitor_cron_expr" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>User's Ended Session PreAuthCancellation run schedule</label>
                </field>
                <field id="send_undo_cron_expr" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Undo run schedule</label>
                </field>
                <field id="order_cancel_email_sender" translate="label" type="select" sortOrder="80" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Order Cancel Email Sender</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                </field>
                <field id="order_cancel_email_template" translate="label comment" type="select" sortOrder="90" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Order Cancel Notification Email Template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
