<script>

require(['jquery', 'jquery/ui'], function($){

	jQuery(document).ready( function() {
		$('input').keyup(function () {
			if ($.trim($(this).val()).length) {
				$(this).addClass('placeholder-remove');
				} else {
				$(this).removeClass('placeholder-remove');
			}
		});

		var required = $('input,textarea,select').filter('[required]:visible');

		$("input[type='submit']").click(function(){
        // ID = $(this).parent().parent().attr('id');
			// alert("button");
			var allRequired = true;
			required.each(function(){
				if($(this).val() == ''){
					allRequired = false;
				}
			});

			if(!allRequired){
				//DO SOMETHING HERE... POPUP AN ERROR MESSAGE, ALERT , ETC.
				alert("Please Fill up the required fields*");
			}

			var url = document.getElementById('website');

			if (!url.value || !url.checkValidity()) {
				alert("Please enter valid URL");
				url.focus()
				return
			}
			

			function ValidateEmail(email) {
				var expr = /^([\w-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
				return expr.test(email);
			};

			if (!ValidateEmail($("#adminEmail").val())) {
				alert("Please enter your valid admin email address");
			}

			
			if (!ValidateEmail($("#purchasingEmail").val())) {
				alert("Please enter your valid purchasing email address");
			}

			if (!ValidateEmail($("#businessEmail").val())) {
				alert("Please enter your valid business email address");
			}
			

		}); 
		
	});

	// jQuery('.btn-primary"').on('click', function() {
	// 	jQuery('input:invalid').css('background-color','red');
	// 	jQuery('input:valid').css('background-color','green');
	// });

});

</script>


