        var div = document.createElement("div");
        div.id = cbox.name;
        // div.innerHTML = "Text to display for " + cbox.name;
		input.name = "othercat"
        div.appendChild(input);
        document.getElementById("insertinputcat").appendChild(div);

      } else {
        document.getElementById(cbox.name).remove();
      }
    }

