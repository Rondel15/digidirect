<?xml version="1.0"?>
<logging xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Logging:etc/logging.xsd">
    <groups>
        <group name="blog_post_items">
            <label translate="true">Manage Blog Post</label>
            <expected_models>
                <expected_model class="Digidirect\Blog\Model\Post" />
            </expected_models>
            <events>
                <event controller_action="digidirect_blog_post_edit" action_alias="view" />
                <event controller_action="digidirect_blog_post_save" action_alias="save">
                    <skip_on_back>
                        <controller_action name="digidirect_blog_post_edit" />
                    </skip_on_back>
                </event>
                <event controller_action="digidirect_blog_post_delete" action_alias="delete" />
            </events>
        </group>
        <group name="blog_category_items">
            <label translate="true">Manage Blog Category</label>
            <expected_models>
                <expected_model class="Digidirect\Blog\Model\Category" />
            </expected_models>
            <events>
                <event controller_action="digidirect_blog_category_edit" action_alias="view" />
                <event controller_action="digidirect_blog_category_save" action_alias="save">
                    <skip_on_back>
                        <controller_action name="digidirect_blog_category_edit" />
                    </skip_on_back>
                </event>
                <event controller_action="digidirect_blog_category_delete" action_alias="delete" />
            </events>
        </group>
        <group name="blog_comment_items">
            <label translate="true">Manage Blog Comment</label>
            <expected_models>
                <expected_model class="Digidirect\Blog\Model\Comment" />
            </expected_models>
            <events>
                <event controller_action="digidirect_blog_comment_edit" action_alias="view" />
                <event controller_action="digidirect_blog_comment_save" action_alias="save">
                    <skip_on_back>
                        <controller_action name="digidirect_blog_comment_edit" />
                    </skip_on_back>
                </event>
                <event controller_action="digidirect_blog_comment_delete" action_alias="delete" />
            </events>
        </group>
    </groups>
</logging>