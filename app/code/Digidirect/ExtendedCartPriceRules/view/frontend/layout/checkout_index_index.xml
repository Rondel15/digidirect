<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="checkout" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <container name="checkout.page.messages" htmlTag="div" htmlClass="page messages" before="-">
                <block class="Magento\Framework\View\Element\Template" name="ajax.message.placeholder" template="Magento_Theme::html/messages.phtml"/>
                <block class="Magento\Framework\View\Element\Messages" name="messages" as="messages" template="Digidirect_Utilities::messages.phtml"/>
            </container>
            <container name="container.remove.cart.item.message" htmlTag="div" htmlClass="cartrule-message" before="-">
                <block name="checkout.remove_cart_item.message" class="Digidirect\ExtendedCartPriceRules\Block\RemoveCartItem\Message" before="-" template="Digidirect_ExtendedCartPriceRules::checkout/message.phtml" />
            </container>
        </referenceContainer>
    </body>
</page>
