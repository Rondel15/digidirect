<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Digidirect_Utilities::Digidirect" title="Digidirect Menu Content">
                    <resource id="Digidirect_AI::integrations" title="Digidirect AI Integrations">
                        <resource id="Digidirect_AI::process_list" title="Integrations list" sortOrder="10"/>
