    <script type="text/javascript">
        
        function filterByBrandName() {
            var x, i;
            x = document.getElementsByClassName("product-item");
            c = document.getElementById("mp-search-new").value;
            for (i = 0; i < x.length; i++) {
              w3RemoveClass(x[i], "show-brand");
              if (x[i].querySelector(".product-item-info > a").getAttribute('title').toLowerCase().includes(c.toLowerCase())) w3AddClass(x[i], "show-brand");
            }
        }
        
        
        function filterSelection(c) {
            var x, i;
            x = document.getElementsByClassName("product-item");
            if (c == "all" || c == "catall") c = "";
            for (i = 0; i < x.length; i++) {
              w3RemoveClass(x[i], "show-brand");
              if (x[i].className.indexOf(c) > -1) w3AddClass(x[i], "show-brand");
            }
        }

        function w3AddClass(element, name) {
            var i, arr1, arr2;
            arr1 = element.className.split(" ");
            arr2 = name.split(" ");
            for (i = 0; i < arr2.length; i++) {
              if (arr1.indexOf(arr2[i]) == -1) {
                element.className += " " + arr2[i];
              }
            }
        }

        function w3RemoveClass(element, name) {
            var i, arr1, arr2;
            arr1 = element.className.split(" ");
            arr2 = name.split(" ");
            for (i = 0; i < arr2.length; i++) {
              while (arr1.indexOf(arr2[i]) > -1) {
                arr1.splice(arr1.indexOf(arr2[i]), 1);
              }
            }
            element.className = arr1.join(" ");
        }   
        
        //window.onload = function() {
        //   filterSelection("all");
        //};
      
      
    </script>
    
