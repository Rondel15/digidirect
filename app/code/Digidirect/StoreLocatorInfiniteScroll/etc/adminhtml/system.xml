<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="digidirect_infinitescroll_config">
            <group id="store_locator_listing_page" translate="label" type="text" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Locator Listing Page</label>
                <field id="enable" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="action" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Load Action</label>
                    <source_model>Digidirect\InfiniteScroll\Model\Config\Source\Action</source_model>
                    <depends>
                        <field  id="enable">1</field>
                    </depends>
                </field>
                <field id="limit" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Load Items on action</label>
                    <validate>validate-not-negative-number integer</validate>
                    <depends>
                        <field  id="enable">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
