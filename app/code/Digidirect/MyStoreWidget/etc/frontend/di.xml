<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="mystorewidget" xsi:type="string">Digidirect\MyStoreWidget\CustomerData\MyStore</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Checkout\Model\ShippingInformationManagement">
        <plugin name="Digidirect_MyStoreWidget::MagentoCheckoutModelShippingInformationManagement" type="Digidirect\MyStoreWidget\Plugin\Magento\Checkout\Model\ShippingInformationManagementPlugin" sortOrder="20"/>
    </type>

    <type name="Magento\Framework\App\Action\AbstractAction">
        <plugin name="Digidirect_MyStoreWidget::MagentoFrameworkAppActionAbstractAction" type="Digidirect\MyStoreWidget\Plugin\Magento\App\Action\ContextPlugin" sortOrder="30"/>
    </type>

    <type name="Magento\Checkout\Model\CompositeConfigProvider">
        <arguments>
            <argument name="configProviders" xsi:type="array">
                <item name="additional_provider" xsi:type="object">Digidirect\MyStoreWidget\Model\CheckoutConfigProvider</item>
            </argument>
        </arguments>
    </type>
</config>
