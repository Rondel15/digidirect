<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digidirect_abstractentity_form.abstractentity_form_data_source</item>
            <item name="deps" xsi:type="string">digidirect_abstractentity_form.abstractentity_form_data_source</item>
        </item>
        <item name="label" translate="true" xsi:type="string">General Information</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">digidirect_abstractentity_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">Digidirect\AbstractEntity\Block\Adminhtml\AbstractEntity\Edit\BackButton</item>
            <item name="delete" xsi:type="string">Digidirect\AbstractEntity\Block\Adminhtml\AbstractEntity\Edit\DeleteButton</item>
            <item name="save" xsi:type="string">Digidirect\AbstractEntity\Block\Adminhtml\AbstractEntity\Edit\SaveButton</item>
            <item name="save_and_continue" xsi:type="string">Digidirect\AbstractEntity\Block\Adminhtml\AbstractEntity\Edit\SaveAndContinueButton</item>
        </item>
    </argument>
    <dataSource name="abstractentity_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Digidirect\AbstractEntity\Ui\DataProvider\Form\AbstractEntityDataProvider</argument>
            <argument name="name" xsi:type="string">abstractentity_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" path="*/*/save" xsi:type="url"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="general">
        <field name="store_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">AbstractEntity</item>
                    <item name="dataScope" xsi:type="string">store_id</item>
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
        </field>
        <field name="attribute_set_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">AbstractEntity</item>
                    <item name="dataScope" xsi:type="string">attribute_set_id</item>
                </item>
            </argument>
        </field>
        <field name="parent_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Digidirect_AbstractEntity/js/form/element/parent-entity-ajax-auto-complete</item>
                    <item name="url" xsi:type="url" path="digidirect_abstractentity/abstractentity/entitySearch"/>
                    <item name="idAttribute" xsi:type="string">entity_id</item>
                    <item name="valueAttribute" xsi:type="string">name</item>
                    <item name="label" xsi:type="string" translate="true">Parent Entity</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">parent_id</item>
                    <item name="sortOrder" xsi:type="number">30</item>
                    <item name="noticeTitle" xsi:type="string" translate="true"><![CDATA[Change it?]]></item>
                    <item name="noticeModal" xsi:type="string" translate="true"><![CDATA[Do you want to proceed?]]></item>
                    <item name="selectedEntityAttribute" xsi:type="string">parent_name</item>
                    <item name="entityIdAttribute" xsi:type="string">entity_id</item>
                    <item name="entityNameAttribute" xsi:type="string">name</item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>
