<?php
/** @var $block \Digidirect\AbstractEntity\Block\Set */
echo $block->escapeHtml($block->getDescription());
$collection = $block->getCollection();
?>
<?php if ($collection): ?>
    <div class="entity-list">
        <?php foreach ($collection as $item): ?>
            <div class="pos-view">
                <?php echo $block->escapeHtml($item->getName()); ?>
                <a href="<?php echo $block->escapeUrl($block->getUrl($item->getUrlKey())); ?>" > <?php /* @escapeNotVerified */ echo __('Detail Page') ?></a>
            </div>
        <?php endforeach; ?>
    </div>
<?php endif; ?>

<?php if ($toolbar = $block->getChildHtml('toolbar')) : ?>
    <div class="toolbar set-toolbar">
        <?php /* @escapeNotVerified */ echo $toolbar ?>
    </div>
<?php endif; ?>
