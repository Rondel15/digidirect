<?php
/** @var $block \Digidirect\AbstractEntity\Block\AbstractEntity */
$abstractEntity = $block->getCurrentAbstractEntity();
?>
<?php if ($abstractEntity): ?>
    <div class="pos-view">
        <?php if ($abstractEntity->getImage()): ?>
            <img src="<?php echo $block->escapeUrl($block->getImageHelper()->init($abstractEntity, 'image')->resize($block->getImageWidth(), $block->getImageHeight())->getUrl()); ?>" alt="<?php echo $block->escapeHtml($abstractEntity->getName()); ?>">
        <?php endif; ?>
        <?php echo $block->getChildHtml('abstractentity_additional_info'); ?>
    </div>
<?php endif; ?>
