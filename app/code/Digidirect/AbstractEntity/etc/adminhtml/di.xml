<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Digidirect\AbstractEntity\Model\ResourceModel\AbstractEntity\Grid\Collection">
        <arguments>
            <argument name="gridColumns" xsi:type="array">
