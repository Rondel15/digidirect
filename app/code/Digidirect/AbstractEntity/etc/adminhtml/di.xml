    <type name="Digidirect\AbstractEntity\Model\ResourceModel\Eav\Attribute">
        <arguments>
            <argument name="resource" xsi:type="object">Magento\Eav\Model\ResourceModel\Entity\Attribute</argument>
        </arguments>
    </type>

    <type name="Digidirect\AbstractEntity\Model\DataFilterPool">
        <arguments>
            <argument name="filters" xsi:type="array">
                <item name="dateTimeFilter" xsi:type="object">Digidirect\AbstractEntity\Model\DataFilter\DateTimeFilter</item>
            </argument>
        </arguments>
