    </type>

    <virtualType name="Digidirect\AbstractEntity\Ui\DataProvider\Form\Modifier\Pool" type="Magento\Ui\DataProvider\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="posData" xsi:type="array">
                    <item name="class" xsi:type="string">Digidirect\AbstractEntity\Ui\DataProvider\Form\Modifier\Data</item>
                    <item name="sortOrder" xsi:type="number">10</item>
