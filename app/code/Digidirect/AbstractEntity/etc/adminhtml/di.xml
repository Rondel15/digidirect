                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
                <item name="relation" xsi:type="array">
                    <item name="class" xsi:type="string">Digidirect\AbstractEntity\Ui\DataProvider\Form\Modifier\Relation</item>
                    <item name="sortOrder" xsi:type="number">100</item>
                </item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Digidirect\AbstractEntity\Ui\DataProvider\Form\AbstractEntityDataProvider">
        <arguments>
            <argument name="pool" xsi:type="object">Digidirect\AbstractEntity\Ui\DataProvider\Form\Modifier\Pool</argument>
        </arguments>
    </type>

    <virtualType name="Digidirect\AbstractEntity\Model\ResourceModel\Eav\Attribute\CollectionFactory" type="Magento\Catalog\Model\ResourceModel\Product\Attribute\CollectionFactory">
        <arguments>
            <argument name="instanceName" xsi:type="string">Digidirect\AbstractEntity\Model\ResourceModel\Eav\Attribute\Collection</argument>
        </arguments>
    </virtualType>
    <type name="Digidirect\AbstractEntity\Block\Adminhtml\Set\Main">
        <arguments>
            <argument name="collectionFactory" xsi:type="object">Digidirect\AbstractEntity\Model\ResourceModel\Eav\Attribute\CollectionFactory</argument>
        </arguments>
    </type>

    <type name="Magento\Backend\Model\Menu\Config\Reader">
        <plugin name="Digidirect_AbstractEntity::addMenuItems" type="Digidirect\AbstractEntity\Plugin\Backend\Model\Menu\Config\Reader" />
    </type>

    <type name="Digidirect\AbstractEntity\Controller\Adminhtml\Set\Save">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="invalidate_cache_types" xsi:type="array">
                    <item name="config" xsi:type="string">config</item>
                    <item name="block_html" xsi:type="string">block_html</item>
