<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template" name="google_maps_js" template="Digidirect_GoogleApi::maps_js.phtml" before="-">
                <arguments>
                    <argument name="maps_url" xsi:type="string">//maps.googleapis.com/maps/api/js</argument>
                    <argument name="libraries" xsi:type="string">places,geometry</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
