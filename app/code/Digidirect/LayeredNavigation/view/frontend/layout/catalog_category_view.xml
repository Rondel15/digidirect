<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="digidirect_layerednavigation"/>
    <body>
        <referenceBlock name="digidirect.layerednavigation.config">
            <arguments>
                <argument name="use_postfix" xsi:type="boolean">true</argument>
            </arguments>
        </referenceBlock>
        <move element="category.products" destination="digidirect.layerednavigation"/>
    </body>
</page>
