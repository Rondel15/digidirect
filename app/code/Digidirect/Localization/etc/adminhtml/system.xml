<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="digidirect_localization" translate="label" type="text" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Localization</label>
            <tab>digidirect</tab>
            <resource>Digidirect_Localization::digidirect_localization</resource>
            <group id="localization" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>
                <field id="use_phone_prefix" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Use Phone Prefix Suggestion</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="phone_suggestion_upload" translate="label" type="Magento\Config\Block\System\Config\Form\Field\File" sortOrder="11" showInDefault="1" showInWebsite="1" >
                    <label>Choose File</label>
                    <backend_model>Digidirect\Localization\Model\Config\Backend\PhoneSuggestionFile</backend_model>
                    <upload_dir config="system" scope_info="1">localization</upload_dir>
                </field>
                <field id="phone_codes" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Phone Prefix Suggestion</label>
                    <frontend_model>Digidirect\Localization\Block\Adminhtml\Form\Field\PhoneCodes</frontend_model>
                    <backend_model>\Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                    <depends>
                        <field id="use_phone_prefix">1</field>
                    </depends>
                </field>
                <field id="length_unit" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Length Unit</label>
                    <source_model>Digidirect\Localization\Model\Config\Source\Locale\LengthUnit</source_model>
                </field>
            </group>
            <group id="timezone" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Time Zone Settings</label>
                <field id="matrix" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Time Zone Settings</label>
                    <frontend_model>Digidirect\Localization\Block\Adminhtml\Config\TimeZoneMatrix</frontend_model>
                    <backend_model>Digidirect\Utilities\Model\System\Config\Backend\DefaultOptionModel</backend_model>
                </field>
            </group>
            <group id="holiday" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Holidays Settings</label>
                <field id="matrix" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Holidays Settings</label>
                    <frontend_model>Digidirect\Localization\Block\Adminhtml\Config\HolidayMatrix</frontend_model>
                    <backend_model>Digidirect\Utilities\Model\System\Config\Backend\DefaultOptionModel</backend_model>
                    <comment><![CDATA[Date format: day/month/year (Example: "4/9/2018"), multiple dates should be comma-separated.]]></comment>
                </field>
            </group>
        </section>
    </system>
</config>
