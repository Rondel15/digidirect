    <label class="label" for="telephone"><span><?= /* @escapeNotVerified */ __('Phone Number') ?></span></label>
    <?php if ($_isLocalizationMode): ?>
        <div class="localization-field control">
            <div class="localization-select">
                <select id="localization_select" data-role="localization-select">
                    <?php foreach ($_localizationItems as $loc => $item): ?>
                        <option value="<?= /* @escapeNotVerified */ $loc; ?>"><?= /* @escapeNotVerified */ $item['countryName']; ?></option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div class="control">
                <input data-role="localization-input" type="text" name="telephone" value="<?= $block->escapeHtml($block->getAddress()->getTelephone()) ?>" title="<?= /* @escapeNotVerified */ __('Phone Number') ?>" class="input-text <?= /* @escapeNotVerified */ $this->helper('Magento\Customer\Helper\Address')->getAttributeValidationClass('telephone') ?> validate-phone-number" id="telephone"/>
            </div>
        </div>
    <?php else: ?>
        <div class="control">
            <input type="text" name="telephone" value="<?= $block->escapeHtml($block->getAddress()->getTelephone()) ?>" title="<?= /* @escapeNotVerified */ __('Phone Number') ?>" class="input-text <?= /* @escapeNotVerified */ $this->helper('Magento\Customer\Helper\Address')->getAttributeValidationClass('telephone') ?>" id="telephone"/>
