<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Framework\View\Element\Html\Link\Current" name="digiclub-tab-link">
                <arguments>
                    <argument name="path" xsi:type="string">digiclubmember/customer/index</argument>
                    <argument name="label" xsi:type="string" translate="true">digiClub</argument>
                    <argument name="sortOrder" xsi:type="number">30</argument>
                    <argument name="attributes" xsi:type="array">
                        <item name="class" xsi:type="string">digiclub-icon</item>
                    </argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Template" template="Digidirect_DigiClubMember::customer/account/digiclub-icon.phtml" name="digiclub-icon" after="digiclub-tab-link"/>
        </referenceBlock>
    </body>
</page>
