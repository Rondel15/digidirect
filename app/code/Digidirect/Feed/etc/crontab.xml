<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="digidirect_feeds">
        <job name="feed_export" instance="\Digidirect\Feed\Cron\Export" method="execute">
            <config_path>digidirect_feed/schedule/cron_expr</config_path>
        </job>

        <job name="feed_history_clean" instance="\Digidirect\Feed\Cron\CleanHistory" method="execute">
            <schedule>5 1 * * *</schedule>
        </job>
    </group>
</config>
