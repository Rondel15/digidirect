<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Digidirect_Feed::config_digidirect_feed" title="Digidirect Feed" translate="title" />
                        </resource>
                    </resource>
                </resource>
                <resource id="Digidirect_Utilities::Digidirect">
                    <resource id="Digidirect_Feed::feed" title="Shopping Feeds" sortOrder="10">
                        <resource id="Digidirect_Feed::feed_feed" title="Feeds" sortOrder="10"/>
                        <resource id="Digidirect_Feed::feed_template" title="Templates" sortOrder="20"/>
                        <resource id="Digidirect_Feed::feed_rule" title="Filters" sortOrder="20"/>
                        <resource id="Digidirect_Feed::feed_dynamic_category" title="Category Mapping" sortOrder="20"/>
                        <resource id="Digidirect_Feed::feed_dynamic_attribute" title="Dynamic Attributes" sortOrder="30"/>
                        <resource id="Digidirect_Feed::feed_report" title="Reports" sortOrder="40"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>