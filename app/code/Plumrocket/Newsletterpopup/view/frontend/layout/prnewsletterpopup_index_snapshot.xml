<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="empty" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <remove src="mage/calendar.css" />
        <remove src="css/styles-l.css" />
        <remove src="requirejs/require.js" />
        <meta name="robots" content="noindex,nofollow" />
    </head>

    <body>
        <container name="root">
            <block class="Plumrocket\Newsletterpopup\Block\Preview\Template" name="prnewsletterpopup.preview" template="Plumrocket_Newsletterpopup::snapshot.phtml" cacheable="false">
                <block class="Plumrocket\Newsletterpopup\Block\Preview\Popup" name="popup.body">
                    <action method="noAnimation" />
                </block>
            </block>
        </container>
    </body>
</page>
