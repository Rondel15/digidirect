<IfVersion < 2.4>
    order allow,deny
    deny from all
    AddDefaultCharset UTF-8
</IfVersion>
<IfVersion >= 2.4>
    Require all denied
</IfVersion>


############################################
## Prevent character encoding issues from server overrides
## If you still have problems, use the second line instead

AddDefaultCharset Off
AddDefaultCharset UTF-8
AddType 'text/html; charset=UTF-8' html