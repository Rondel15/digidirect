                                   data-validate="<?= $block->escapeHtml(json_encode($block->getQuantityValidators())) ?>" readonly/>
                            <div role="button" class="qty-increase" data-bind="click: increaseQty">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M8 4v8M4 8h8"/>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            <?php endif; ?>
            <div class="actions">
                    <?php if ($_attributeValue == "Yes"): ?>
