                            </div>
                            <i class="fa-solid fa-cart-plus" style=" font-family: 'Font Awesome 5 Free';font-style: unset;color: #fff;padding-right: 5px;"></i>
                            <span class="addcart_words"><?= /* @escapeNotVerified */ 'Pre-Order' ?></span>
                        </button>
                    <?php else : ?>
                        <button type="submit"
                            class="action tocart btn_cart tocart-pdp-btn"
                            id="product-addtocart-button"
                            data-action="add-to-cart-action"
                            >
                            <i class="fa-solid fa-cart-plus" style=" font-family: 'Font Awesome 5 Free';font-style: unset;color: #fff;padding-right: 5px;"></i>
                            <span class="addcart_words"><?= /* @escapeNotVerified */ $buttonTitle ?></span>
                        </button>
                    <?php endif; ?>

                <?= $block->getChildHtml('', true) ?>
            </div>
        </div>
    </div>

<?php endif; ?>

