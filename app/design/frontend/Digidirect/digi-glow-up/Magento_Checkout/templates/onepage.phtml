    <script type="text/javascript">
        require([
            'jquery',
            'emailNextBtn',
            'shippingAddressNextBtn'
            ],
        function($,emailNextBtn,shippingAddressNextBtn) {

            $("body").on("click", ".shipping-methods.table-checkout-shipping-method.items li:not('.collect')", function(){


                let username = $('[name="username"]').val();
                let firstname = $('[name="firstname"]').val();
                let lastname = $('[name="lastname"]').val();
                let telephone = $('[name="telephone"]').val();
                let street = $('[name="street[0]"]').val();
                let city = $('[name="city"]').val();
                let postcode = $('[name="postcode"]').val();

                //create logic for new step class checkout-customer-information

                if(username != ""){

                   var target = $('.checkout-customer-information');
                    if (target.length) {
                        $('html,body').animate({
                            scrollTop: target.offset().top
                        }, 1000);

                        $(".checkout-customer-information .accordion-step").removeClass("active");
                        $(".checkout-customer-information .step-content").fadeOut("slow", "swing");

                        return false;
                    }
                }
                else if(firstname != ""
                    && lastname != ""
                    && telephone != ""
                    && street != ""
                    && city != ""
                    && postcode != ""){

                    var target = $('.checkout-shipping-address');
                    if (target.length) {
                        $('html,body').animate({
                            scrollTop: target.offset().top
                        }, 1000);

                        $(".checkout-shipping-address .accordion-step").removeClass("active");
                        $(".checkout-shipping-address .step-content").fadeOut("slow", "swing");

                        return false;
                    }
                }
                else{
                    if($("#shipping-address-select").length > 0){
                        var target = $('.checkout-shipping-address');
                        if (target.length) {
                            $('html,body').animate({
                                scrollTop: target.offset().top
                            }, 1000);

                            $(".checkout-shipping-address .accordion-step").removeClass("active");
                            $(".checkout-shipping-address .step-content").fadeOut("slow", "swing");

                            return false;
                        }
                    }
                    else{
                        $("#shipping-method-buttons-container .continue").trigger("click");
                    }

                }
            });

            $("body").on("click", "#shipping-button-extension", function(){

                //comment to redeploy
                if($('[name="username"]').length > 0)
                {
                    let username = $('[name="username"]').val();
                    if(username == ""){
                        $(".checkout-shipping-address .accordion-step").addClass("active");
                        $(".checkout-shipping-method .accordion-step").addClass("active");

                        $(".checkout-shipping-address .step-content").fadeIn("slow", "swing");
                        $(".checkout-shipping-method .step-content").fadeIn("slow", "swing");

                    }
                }


                if($(".field-error").length > 0){
                    $(".checkout-shipping-address .accordion-step").addClass("active");
                    $(".checkout-shipping-method .accordion-step").addClass("active");

                    $(".checkout-shipping-address .step-content").fadeIn("slow", "swing");
                    $(".checkout-shipping-method .step-content").fadeIn("slow", "swing");

                }

                $("#shipping-method-buttons-container .continue").trigger("click");
            });

            $("body").on("click", "#payment-button-extension", function(){
                $(".order-trigger").trigger("click");
            });

});
</script>
