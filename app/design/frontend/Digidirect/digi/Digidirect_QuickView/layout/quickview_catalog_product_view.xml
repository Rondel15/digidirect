<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <attribute name="class" value="quickview-main"/>

        <move element="product.view.top" destination="content" before="-"/>
        <move element="bundle.options.container" destination="content" after="product.view.top"/>

        <referenceBlock name="product.view.bg" remove="true"/>
        <referenceBlock name="page.below.container" remove="true"/>
        <referenceContainer name="product.info.media.wrapper" remove="true"/>
        <referenceContainer name="product.view.overview" remove="true"/>
    </body>
</page>