<script>

    function openSecondLevel(evt, className, topBrands, firstLevel) {

        var x;
        firstcategories = document.getElementsByClassName("mgz-tabs-tab-title");

        var y;
        firstcategoriestitle = document.getElementsByClassName("first-menu-tab-title");

        if (document.getElementById(firstLevel).classList.contains("active-category")) {
            document.getElementById(firstLevel).classList.remove("active-category");
            for (x = 0; x < firstcategories.length; x++) {
                firstcategories[x].removeAttribute('style');
            }
            for (y = 0; y < firstcategoriestitle.length; y++) {
                firstcategoriestitle[y].removeAttribute('style');
            }
            document.getElementById("second-level-menu").style.display = "none";
            document.getElementById("third-level-menu").style.display = "none";
            document.getElementById("fourth-level-menu").style.display = "none";
            document.getElementById("menu-top-brands").style.display = "none";
            document.getElementById("shop-by-category-tabs").style.removeProperty("width");
        } else {
            for (x = 0; x < firstcategories.length; x++) {
                firstcategories[x].setAttribute('style', 'width: 100px !important');
                firstcategories[x].classList.remove("active-category");
            }
            document.getElementById(firstLevel).classList.add("active-category");

            for (y = 0; y < firstcategoriestitle.length; y++) {
                firstcategoriestitle[y].style.display = "none";
            }

            var i;
            tabcontent = document.getElementsByClassName("second-level-content");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }

            document.getElementById("second-level-menu").style.width= "330px";
            document.getElementById("second-level-menu").style.display = "block";
            document.getElementById(className).style.display = "block";
            document.getElementById("third-level-menu").style.display = "none";
            document.getElementById("fourth-level-menu").style.display = "none";

            var z;
            topbrands = document.getElementsByClassName("top-brands-brand");
            for (z = 0; z < topbrands.length; z++) {
                topbrands[z].style.display = "none";
            }

            document.getElementById("menu-top-brands").style.width= "100px";
            document.getElementById("menu-top-brands").style.display = "block";

            if (screen.width < 1281) {
                document.getElementById(topBrands).style.display = "grid";
            } else {
                document.getElementById(topBrands).style.display = "block";
            }

            if (screen.width < 1281) {
                document.getElementById("shop-by-category-tabs").style.width = "auto";
            }
        }

        for (x = 0; x < firstcategories.length; x++) {
            firstcategories[x].classList.add("hide-first-level");
        }
        //Scroll To Top
        //window.scrollTo(0, 0);

    }

    function resetMenu() {

        var x;
        firstcategories = document.getElementsByClassName("mgz-tabs-tab-title");
        for (x = 0; x < firstcategories.length; x++) {
            firstcategories[x].removeAttribute('style');
            firstcategories[x].classList.remove("active-category");
        }

        var y;
        firstcategoriestitle = document.getElementsByClassName("first-menu-tab-title");
        for (y = 0; y < firstcategoriestitle.length; y++) {
            firstcategoriestitle[y].removeAttribute('style');
        }

        document.getElementById("second-level-menu").style.display = "none";
        document.getElementById("third-level-menu").style.display = "none";
        document.getElementById("fourth-level-menu").style.display = "none";
        document.getElementById("menu-top-brands").style.display = "none";
        document.getElementById("shop-by-category-tabs").style.removeProperty("width");

        for (x = 0; x < firstcategories.length; x++) {
            firstcategories[x].classList.remove("hide-first-level");
        }
    }

    function openThirdLevel(evt, category) {

        document.getElementById("third-level-menu").style.width= "330px";
        document.getElementById("third-level-menu").style.display = "block";

        var i, tabcontent, tablinks, secondLevel;
        tabcontent = document.getElementsByClassName("tabcontent");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }

        tablinks = document.getElementsByClassName("tablinks");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }

        document.getElementById(category).style.display = "block";
        evt.currentTarget.className += " active";

        secondLevel = document.getElementsByClassName("menu-second-level");
        if (screen.width < 1281) {
            for (i = 0; i < secondLevel.length; i++) {
                //secondLevel[i].style.display = "none";
            }
        }

        if (screen.width < 1281) {
            document.getElementById("second-level-menu").style.display = "none";
        }
    }

    function openFourthLevel(evt, category) {

        document.getElementById("fourth-level-menu").style.width= "330px";
        document.getElementById("fourth-level-menu").style.display = "block";

        var parent = document.getElementById("fourth-level-menu");
        var i, tabcontent, tablinks, thirdLevel;
        tabcontent = parent.querySelectorAll(".tabcontent");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }

        tablinks = document.getElementsByClassName("tablinks");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }

        document.getElementById(category).style.display = "block";
        evt.currentTarget.className += " active";

        thirdLevel = document.getElementsByClassName("menu-third-level");
        if (screen.width < 1281) {
            for (i = 0; i < thirdLevel.length; i++) {
                //secondLevel[i].style.display = "none";
            }
        }

        if (screen.width < 1281) {
            document.getElementById("third-level-menu").style.display = "none";
        }
    }

    function openServiceMenu(event, serviceMenu) {
        var i,x;
        menu = document.getElementsByClassName("menu-services");
        for (i = 0; i < menu.length; i++) {
            menu[i].classList.remove("menu-active");
        }
        menuTitle = document.getElementsByClassName("menu-services-title");
        for (x = 0; x < menuTitle.length; x++) {
            menuTitle[x].classList.remove("title-active");
        }
        event.currentTarget.className += " title-active";
        document.getElementById(serviceMenu).classList.add("menu-active");
    }

    function checkActiveMenuItem(event, itemSubMenu) {
        var i;
        if (screen.width < 1281) {

            if (document.getElementById(itemSubMenu).classList.contains("submenu-active")) {
                document.getElementById(itemSubMenu).classList.remove("submenu-active");
            } else {
                document.getElementById(itemSubMenu).classList.add("submenu-active");
            }

            subMenu = document.getElementsByClassName("item-submenu");
            for (i = 0; i < subMenu.length; i++) {
                if (subMenu[i].id != itemSubMenu) {
                    subMenu[i].classList.remove("submenu-active");
                }
                //subMenu[i].classList.remove("submenu-active");
            }


            //document.getElementById(itemSubMenu).scrollIntoView();
        }

    }

    function returnToSecondLayer() {
        document.getElementById("second-level-menu").style.display = "block";
        document.getElementById("third-level-menu").style.display = "none";
        document.getElementById("fourth-level-menu").style.display = "none";
    }

    function returnToThirdLayer() {
        document.getElementById("second-level-menu").style.display = "none";
        document.getElementById("third-level-menu").style.display = "block";
        document.getElementById("fourth-level-menu").style.display = "none";
    }

    function returnToFirstLevel() {
        resetMenu();
    }


    function openDigiPrintSecondLevel(evt, className) {
        var i;
        tabcontent = document.getElementsByClassName("second-level-content");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].removeAttribute('style');
        }
        document.getElementById("digiprint-second-level").removeAttribute('style');
        document.getElementById(className).removeAttribute('style');
        document.getElementById("digiprint-second-level").style.display = "block";
        document.getElementById(className).style.display = "block";

        if (window.innerWidth < 1280) {
            document.getElementById("photolab-listing").style.display = "none";
        } else {
            document.getElementById("photolab-listing").style.display = "block";
        }

    }

    function resetDigiPrintSecondLevel() {
        document.getElementById("digiprint-second-level").removeAttribute('style');
    }

    function returnToFirstLevelDigiPrint() {
        document.getElementById("photolab-listing").style.display = "grid";
        document.getElementById("digiprint-second-level").removeAttribute('style');
    }

</script>

