<?php
$_option = $block->getOption();
$class = ($_option->getIsRequire()) ? ' required' : '';
?>
<div class="field<?= /* @noEscape */ $class ?>">
    <?php
        if ($_option->getTitle() == 'digiProtect') {?>
        <div class="tooltip protect-tooltip">
            <img class="digiprotect-info-logo" src="<?php echo $block->getUrl("media/wysiwyg/digiprotect")?>digiProtect.png"/>
            <span class="tooltiptext" style="display: none;">
                <a href="#" class="close-tooltip-trigger"></a>
