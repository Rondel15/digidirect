    <?php $detailedInfoGroup = array_intersect($childNames, $detailedInfoGroup); ?>
<div class="product info detailed">
    <?php $layout = $block->getLayout(); ?>
    <div class="product data items details-tab" id="details-tab">
        
        <?php foreach ($detailedInfoGroup as $name): ?>
            <?php
            $html = $layout->renderElement($name);
            if (!trim($html)) {
                continue;
            }
            $alias = $layout->getElementAlias($name);
            $aliasName = $alias;

            if ($alias == 'additionalinfo') {
                $aliasName = $block->escapeHtml(__('Additional Information'));
            }

            if ($alias == 'description') {
                $aliasName = $block->escapeHtml(__('Product Description'));
            }

            if ($alias == 'whatinthebox') {
                $aliasName = $block->escapeHtml(__('What’s In The Box'));
            }

            if ($alias == 'productoverview') {
                $aliasName = $block->escapeHtml(__('Product Overview'));
            }
            
            if ($alias == 'spec') {
                $aliasName = $block->escapeHtml(__('Specs'));
            }
            
            if ($alias == 'reviews') {
                $aliasName = $block->escapeHtml(__('Product Review'));
            }

            $label = $block->getChildData($alias, 'title');
          
            ?>
            <div class="data item title tab-in <?= /* @escapeNotVerified */ $alias ?> tab_check"
                 data-alias="<?= /* @escapeNotVerified */ $alias ?>"
                 aria-labeledby="tab-label-<?= /* @escapeNotVerified */ $alias ?>-title"
                 data-role="collapsible" id="tab-label-<?= /* @escapeNotVerified */ $alias ?>">
                <a class="data switch"
                   tabindex="-1"
                   data-toggle="switch"
                   href="#<?= /* @escapeNotVerified */ $alias ?>"
                   id="tab-label-<?= /* @escapeNotVerified */ $alias ?>-title">
                    <?= /* @escapeNotVerified */ $aliasName ?>
                    <div class="arrow">
                       <!--  <svg xmlns="http://www.w3.org/2000/svg" class="svg-icon svgi-action">
                            <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#svgi-left"></use>
                        </svg> -->
                    </div>
                </a>
            </div>
                <div class="data item content tab_details <?= /* @escapeNotVerified */ $alias ?>" id="<?= /* @escapeNotVerified */ $alias ?>" data-role="content">
                    <?= /* @escapeNotVerified */ $html; ?>
                    <div class="read-more">
                        <div class="title">
                            <span class="readmore">
                                <?php echo $block->escapeHtml(__('+ Read more')); ?>
                            </span>
                        </div>
                    </div>
