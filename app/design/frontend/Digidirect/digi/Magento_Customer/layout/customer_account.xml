<?xml version="1.0"?>
<page layout="2columns-left" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer-account-navigation-checkout-sku-link" remove="true" />
        <referenceBlock name="customer-account-navigation-downloadable-products-link" remove="true" />
        <referenceBlock name="customer-account-navigation-giftregistry-link" remove="true" />
        <referenceBlock name="customer-account-navigation-magento-invitation-link" remove="true" />
        <referenceBlock name="customer-account-navigation-billing-agreements-link" remove="true" />
        <referenceBlock name="customer-account-navigation-price-subscriptions-link" remove="true" />
        <referenceBlock name="customer-account-navigation-stock-subscriptions-link" remove="true" />
        <referenceBlock name="customer-account-navigation-my-credit-cards-link" remove="true" />
        <referenceBlock name="customer-account-navigation-customer-balance-link" remove="true" />
        <referenceBlock name="customer-account-navigation-reward-link" remove="true" />
        <referenceBlock name="customer-account-navigation-delimiter-1" remove="true" />
        <referenceBlock name="customer-account-navigation-delimiter-2" remove="true" />

        <move element="div.sidebar.main" destination="main.content" before="columns.top"/>
        <move element="customer-account-navigation-newsletter-subscriptions-link" destination="customer_account_navigation" after="-"/>
        <referenceBlock name="customer-account-navigation-return-history-link" remove="true"/>

        <referenceContainer name="sidebar.main">
            <container name="div.account.navigation.container" htmlTag="div" htmlClass="secondary-nav collapsible" before="-" />
        </referenceContainer>

        <referenceBlock name="customer-account-navigation-account-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Account</argument>
                <argument name="sortOrder" xsi:type="number">370</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-account-edit-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Profile</argument>
                <argument name="sortOrder" xsi:type="number">350</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-address-link">
            <arguments>
                <argument name="sortOrder" xsi:type="number">330</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-orders-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Order History</argument>
                <argument name="sortOrder" xsi:type="number">310</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-product-reviews-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Product Reviews</argument>
                <argument name="sortOrder" xsi:type="number">270</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="customer-account-navigation-newsletter-subscriptions-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Newsletter Subscription</argument>
                <argument name="sortOrder" xsi:type="number">210</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="customer-account-navigation-wish-list-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Wishlist</argument>
                <argument name="sortOrder" xsi:type="number">250</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="customer-account-navigation-gift-card-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Gift Card</argument>
                <argument name="sortOrder" xsi:type="number">230</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="account-navigation-icon-account"
                   template="Magento_Customer::account/navigation-icon.phtml" after="customer-account-navigation-account-link">
                <arguments>
                    <argument name="sortOrder" xsi:type="number">360</argument>
                    <argument name="icon_id" xsi:type="string">account</argument>
                </arguments>
            </block>
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="account-navigation-icon-profile"
                   template="Magento_Customer::account/navigation-icon.phtml" after="customer-account-navigation-account-edit-link">
                <arguments>
                    <argument name="sortOrder" xsi:type="number">340</argument>
                    <argument name="icon_id" xsi:type="string">profile</argument>
                </arguments>
            </block>
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="account-navigation-icon-address"
                   template="Magento_Customer::account/navigation-icon.phtml">
                <arguments>
                    <argument name="sortOrder" xsi:type="number">320</argument>
                    <argument name="icon_id" xsi:type="string">address</argument>
                </arguments>
            </block>
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="account-navigation-icon-order"
                   template="Magento_Customer::account/navigation-icon.phtml">
                <arguments>
                    <argument name="sortOrder" xsi:type="number">300</argument>
                    <argument name="icon_id" xsi:type="string">orders</argument>
                </arguments>
            </block>
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="account-navigation-icon-returns"
                   template="Magento_Customer::account/navigation-icon.phtml" ifconfig="sales/magento_rma/enabled">
                <arguments>
                    <argument name="sortOrder" xsi:type="number">280</argument>
                    <argument name="icon_id" xsi:type="string">returns</argument>
                </arguments>
            </block>
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="account-navigation-icon-review"
                   template="Magento_Customer::account/navigation-icon.phtml">
                <arguments>
                    <argument name="sortOrder" xsi:type="number">260</argument>
                    <argument name="icon_id" xsi:type="string">reviews</argument>
                </arguments>
            </block>
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="account-navigation-icon-wishlist"
                   template="Magento_Customer::account/navigation-icon.phtml">
                <arguments>
                    <argument name="sortOrder" xsi:type="number">240</argument>
                    <argument name="icon_id" xsi:type="string">account-wishlist</argument>
                </arguments>
            </block>
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="account-navigation-icon-gift"
                   template="Magento_Customer::account/navigation-icon.phtml">
                <arguments>
                    <argument name="sortOrder" xsi:type="number">220</argument>
                    <argument name="icon_id" xsi:type="string">account-gift</argument>
                </arguments>
            </block>
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="account-navigation-icon-newsletter"
                   template="Magento_Customer::account/navigation-icon.phtml">
                <arguments>
                    <argument name="sortOrder" xsi:type="number">200</argument>
                    <argument name="icon_id" xsi:type="string">newsletter</argument>
                </arguments>
            </block>
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="customer-account-navigation-return-history-link-new" ifconfig="sales/magento_rma/enabled">
                <arguments>
                    <argument name="path" xsi:type="string">rma/returns/history</argument>
                    <argument name="label" xsi:type="string">Returns</argument>
                    <argument name="sortOrder" xsi:type="number">290</argument>
                </arguments>
            </block>
        </referenceBlock>
        <!-- Move account nav into collapse block -->
        <block class="Magento\Framework\View\Element\Template" name="customer_account_navigation_block" template="Magento_Customer::html/collapsible.phtml" before="-">
            <arguments>
                <argument name="block_title" translate="true" xsi:type="string">Account</argument>
                <argument name="block_css" xsi:type="string">block-collapsible-nav</argument>
                <argument name="icon_id" xsi:type="string">account</argument>
            </arguments>
        </block>
        <move element="customer_account_navigation" destination="customer_account_navigation_block" before="-" />
        <move element="customer_account_navigation_block" destination="div.account.navigation.container" before="-" />
    </body>
</page>
